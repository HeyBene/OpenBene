{
  "schema_version": 1,
  "map_id": "openbene_demo_floor",
  "name": "OpenBene Demo Floor",
  "units": "meters",
  "frame": {
    "type": "2d",
    "x": "east",
    "y": "north",
    "yaw_deg": "counter-clockwise from +x, right-handed, z up"
  },
  "notes": [
    "Markers are printed sheets lying flat on the floor (or taped to the floor).",
    "marker.pose.yaw_deg is the map-frame direction of the marker image +y axis",
    "(the direction from the bottom edge of the print to its top edge).",
    "marker.pose is the physical position of the marker sheet, not the robot position.",
    "Place a marker roughly one meter ahead of its location, along the approach direction,",
    "so the forward-looking, down-tilted camera of the robot can see it."
  ],
  "markers": [
    {
      "id": "mk_entrance",
      "kind": "qr",
      "payload": "openbene:mk_entrance",
      "ar_image": "openbene_mk_entrance",
      "size_m": 0.2,
      "pose": { "x": 1.0, "y": 0.0, "yaw_deg": 0.0 }
    },
    {
      "id": "mk_junction",
      "kind": "qr",
      "payload": "openbene:mk_junction",
      "ar_image": "openbene_mk_junction",
      "size_m": 0.2,
      "pose": { "x": 5.0, "y": 0.0, "yaw_deg": 0.0 }
    },
    {
      "id": "mk_room101",
      "kind": "qr",
      "payload": "openbene:mk_room101",
      "ar_image": "openbene_mk_room101",
      "size_m": 0.2,
      "pose": { "x": 6.0, "y": 3.0, "yaw_deg": 90.0 }
    },
    {
      "id": "mk_room102",
      "kind": "qr",
      "payload": "openbene:mk_room102",
      "ar_image": "openbene_mk_room102",
      "size_m": 0.2,
      "pose": { "x": 11.0, "y": 0.0, "yaw_deg": 0.0 }
    }
  ],
  "locations": [
    {
      "id": "loc_entrance",
      "name": "Entrance",
      "marker_id": "mk_entrance",
      "pose": { "x": 0.0, "y": 0.0, "yaw_deg": 0.0 }
    },
    {
      "id": "loc_junction",
      "name": "Corridor Junction",
      "marker_id": "mk_junction",
      "pose": { "x": 6.0, "y": 0.0, "yaw_deg": 0.0 }
    },
    {
      "id": "loc_room101",
      "name": "Room 101 Door",
      "marker_id": "mk_room101",
      "pose": { "x": 6.0, "y": 4.0, "yaw_deg": 90.0 }
    },
    {
      "id": "loc_room102",
      "name": "Room 102 Door",
      "marker_id": "mk_room102",
      "pose": { "x": 12.0, "y": 0.0, "yaw_deg": 0.0 }
    }
  ],
  "edges": [
    {
      "id": "e_entrance_junction",
      "from": "loc_entrance",
      "to": "loc_junction",
      "bidirectional": true,
      "direction": "forward",
      "path": [
        { "x": 0.0, "y": 0.0 },
        { "x": 3.0, "y": 0.0 },
        { "x": 6.0, "y": 0.0 }
      ]
    },
    {
      "id": "e_junction_room101",
      "from": "loc_junction",
      "to": "loc_room101",
      "bidirectional": true,
      "direction": "left",
      "path": [
        { "x": 6.0, "y": 0.0 },
        { "x": 6.0, "y": 2.0 },
        { "x": 6.0, "y": 4.0 }
      ]
    },
    {
      "id": "e_junction_room102",
      "from": "loc_junction",
      "to": "loc_room102",
      "bidirectional": true,
      "direction": "forward",
      "path": [
        { "x": 6.0, "y": 0.0 },
        { "x": 9.0, "y": 0.0 },
        { "x": 12.0, "y": 0.0 }
      ]
    }
  ],
  "rooms": [
    { "id": "room_101", "name": "Room 101", "location_id": "loc_room101" },
    { "id": "room_102", "name": "Room 102", "location_id": "loc_room102" }
  ]
}
